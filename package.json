{
  "name": "eldown",
  "productName": "ELDown",
  "version": "1.0.0",
  "description": "ELDown",
  "tagline": "Premium standalone media downloader — works with or without Elaris.",
  "author": "ELDown",
  "main": "src/main/index.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node test/renderer-boot.test.js && node test/bugfixes.test.js && node test/eldrop.test.js && node test/tiktok.test.js && node test/uichanges.test.js && node test/uifixes.test.js && node test/autoupdate.test.js",
    "dev": "cross-env ELDOWN_DEV=1 electron .",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build": "electron-builder --mac --win",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "electron-updater": "^6.3.9",
    "semver": "^7.6.3"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^32.1.2",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.eldown.app",
    "productName": "ELDown",
    "files": [
      "src/**/*",
      "assets/**/*",
      "!**/*.map"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "assets/icons/mac/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "win": {
      "icon": "assets/icons/win/icon.ico",
      "executableName": "ELDown",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "ELDown"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "eloise-ae",
        "repo": "eldown",
        "releaseType": "release"
      }
    ]
  }
}